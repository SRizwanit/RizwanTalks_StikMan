{
  "name": "rizwantalks-intro",
  "version": "1.0.0",
  "private": true,
  "description": "RizwanTalks stick-figure intro: Python (script/voice/timing) + React + Remotion",
  "scripts": {
    "timeline": "python3 python/build_timeline.py",
    "timeline:voice": "python3 python/build_timeline.py --voice",
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Intro out/rizwantalks_intro.mp4 --codec h264 --crf 18",
    "still": "remotion still src/index.ts Intro out/still.png --frame 20"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/google-fonts": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "typescript": "^5.4.0"
  }
}
